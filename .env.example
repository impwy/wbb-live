# WBB environment variable template. Copy to .env (never commit) and fill in
# real values. All secrets come from the environment only.

# dev | prod
WBB_ENV=dev

# HTTP listen address
WBB_ADDR=:8080

# PostgreSQL DSN (required)
WBB_DATABASE_URL=postgres://wbb:wbb-dev-password@127.0.0.1:55432/wbb

# Redis address (session cache, fail closed for protected APIs)
WBB_REDIS_ADDR=127.0.0.1:56379

# JWT signing secret, >= 32 bytes. Required in prod; generated per-process in
# dev when unset (tokens then do not survive restarts).
WBB_JWT_SECRET=replace-with-32+-random-bytes

# Exact browser origins allowed for auth POST endpoints (register, login,
# refresh, logout). Same-origin production value: https://live.wombatburrow.com
WBB_CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Token lifetimes
WBB_ACCESS_TOKEN_TTL=10m
WBB_REFRESH_TOKEN_TTL=168h

# Fixed-window rate limit for auth endpoints, per IP and per account
WBB_RATE_LIMIT_REQUESTS=30
WBB_RATE_LIMIT_ACCOUNT_REQUESTS=10
WBB_RATE_LIMIT_WINDOW=1m

# Optional: serve a built Flutter Web bundle (directory with index.html)
# WBB_STATIC_DIR=./static
