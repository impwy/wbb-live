FROM golang:1.27.3-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/wbb-outbox-deliver ./cmd/wbb-outbox-deliver

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /out/wbb-outbox-deliver /usr/local/bin/wbb-outbox-deliver
ENTRYPOINT ["/usr/local/bin/wbb-outbox-deliver"]
