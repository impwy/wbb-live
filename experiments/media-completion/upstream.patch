+++ b/internal/core/completion_test.go
@@ -0,0 +1,63 @@
+package core
+
+import (
+	"runtime"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/bluenviron/mediamtx/internal/conf"
+	"github.com/bluenviron/mediamtx/internal/logger"
+)
+
+func TestCompletionRejectsCredentialBearingDiagnostics(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("completion experiment runs on Linux")
+	}
+	for _, ca := range []struct {
+		name string
+		conf conf.Conf
+	}{
+		{name: "debug", conf: conf.Conf{LogLevel: conf.LogLevel(logger.Debug)}},
+		{name: "packet_dump", conf: conf.Conf{DumpPackets: true}},
+	} {
+		t.Run(ca.name, func(t *testing.T) {
+			require.ErrorContains(t, validateCompletionConf(&ca.conf), "debug logging and packet dumps are unsupported")
+		})
+	}
+}
+
+func TestCompletionRejectsUntrackedPathMediaEffects(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("completion experiment runs on Linux")
+	}
+	base := func() conf.Conf {
+		return conf.Conf{
+			WebRTC: true, HLS: true, API: true, RTSP: true,
+			AuthMethod: conf.AuthMethodHTTP, AuthHTTPAddress: "http://auth.invalid/callback",
+			PathDefaults: conf.Path{Source: "publisher"},
+			Paths:        map[string]*conf.Path{"example": {Source: "publisher"}},
+		}
+	}
+	control := base()
+	require.NoError(t, validateCompletionConf(&control))
+	for _, ca := range []struct {
+		name string
+		edit func(*conf.Path)
+	}{
+		{name: "always_available", edit: func(p *conf.Path) { p.AlwaysAvailable = true }},
+		{name: "forward", edit: func(p *conf.Path) { p.Forward = conf.Forward{{Dest: "rtsp://127.0.0.1:8554/other"}} }},
+	} {
+		for _, where := range []string{"defaults", "path"} {
+			t.Run(ca.name+"_"+where, func(t *testing.T) {
+				c := base()
+				if where == "defaults" {
+					ca.edit(&c.PathDefaults)
+				} else {
+					ca.edit(c.Paths["example"])
+				}
+				require.ErrorContains(t, validateCompletionConf(&c), "unsupported path")
+			})
+		}
+	}
+}
