# Copy to .env and replace the placeholder hash. Never commit .env.
# Generate a hash with `docker run --rm -it caddy:2.10-alpine caddy hash-password`.
# Do not pass a real password as a shell argument.
WBB_MEDIA_AUTH_USER=media-check-user
# Single quotes keep bcrypt dollars literal in Docker Compose.
WBB_MEDIA_AUTH_HASH='$2a$14$REPLACE_WITH_REAL_BCRYPT_HASH'
WBB_MEDIA_HOSTNAME=127.0.0.1
WBB_MEDIA_HTTPS_PORT=18443
WBB_MEDIA_ORIGIN=https://127.0.0.1:18443
WBB_MEDIA_BIND_IP=127.0.0.1
WBB_MEDIA_ICE_HOST=127.0.0.1
WBB_MEDIA_ICE_PORT=18391
# Choose explicitly. VAAPI never falls back to CPU after an encoder failure.
WBB_MEDIA_ENCODER=cpu

# Proposed public Origin at standard HTTPS 443: https://live.wombatburrow.com
# At 18443, keep the explicit port as above. This sample remains loopback-only.
