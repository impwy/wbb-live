+func TestBeforeSessionInitializeBarrierDoesNotBlockOtherSession(t *testing.T) {
+	dir := t.TempDir()
+	anchor := filepath.Join(t.TempDir(), "anchor")
+	if err := os.WriteFile(anchor, []byte(`{"slot":"s","root":"r"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := wbbcompletion.Bootstrap(anchor, dir); err != nil {
+		t.Fatal(err)
+	}
+	r, err := wbbcompletion.Open(anchor, dir, 3)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r.EnableBarriers()
+	defer r.AbortBarriers()
+	if err := r.ArmBarrier(wbbcompletion.BeforeSessionInitialize, "a"); err != nil {
+		t.Fatal(err)
+	}
+	a, err := r.Begin("a", "path-a", "digest-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := r.Begin("b", "path-b", "digest-b")
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := &Server{ctx: context.Background(), chNewSession: make(chan newSessionReq)}
+	aResult := make(chan newSessionRes, 1)
+	go func() {
+		aResult <- s.newSession(newSessionReq{ctx: context.Background(), pathName: "a", completion: a})
+	}()
+	deadline := time.Now().Add(time.Second)
+	for !r.BarrierStatus(wbbcompletion.BeforeSessionInitialize, "a").Arrived && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if !r.BarrierStatus(wbbcompletion.BeforeSessionInitialize, "a").Arrived {
+		t.Fatal("A did not reach its barrier")
+	}
+	bResult := make(chan newSessionRes, 1)
+	go func() {
+		bResult <- s.newSession(newSessionReq{ctx: context.Background(), pathName: "b", completion: b})
+	}()
+	select {
+	case req := <-s.chNewSession:
+		if req.pathName != "b" {
+			t.Fatalf("held A entered the shared event loop: %s", req.pathName)
+		}
+		req.res <- newSessionRes{errStatusCode: http.StatusConflict, err: fmt.Errorf("test complete")}
+	case <-time.After(time.Second):
+		t.Fatal("B could not enter the shared event loop while A was held")
+	}
+	<-bResult
+	if got := r.CloseOperation("a"); got.State != wbbcompletion.Closing {
+		t.Fatalf("held A closed early: %s", got.State)
+	}
+	if err := r.ReleaseBarrier(wbbcompletion.BeforeSessionInitialize, "a"); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case result := <-aResult:
+		if result.errStatusCode != http.StatusConflict {
+			t.Fatalf("closed A entered the loop: %d", result.errStatusCode)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("A did not leave after barrier release")
+	}
+	a.DoneCreation()
+	b.DoneCreation()
+	if got := r.Query("a"); got.State != wbbcompletion.Completed {
+		t.Fatalf("A completion after release: %s", got.State)
+	}
+}
