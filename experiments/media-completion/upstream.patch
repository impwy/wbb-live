+func TestBootstrapRequiredAndEpochContinuity(t *testing.T) {
+	dir := t.TempDir()
+	anchor := filepath.Join(t.TempDir(), "anchor")
+	if err := os.WriteFile(anchor, []byte(`{"slot":"slot-a","root":"root-a"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Open(anchor, dir, 2); err == nil {
+		t.Fatal("empty history accepted without bootstrap")
+	}
+	if err := Bootstrap(anchor, dir); err != nil {
+		t.Fatal(err)
+	}
+	r, err := Open(anchor, dir, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(r.Epoch()) != 32 || r.Lifecycle().EpochSequence != 1 || r.Lifecycle().Root != "root-a" {
+		t.Fatalf("invalid lifecycle: epoch length=%d sequence=%d", len(r.Epoch()), r.Lifecycle().EpochSequence)
+	}
+	// A live registry must retain its lock until process exit. The same-process
+	// close path is intentionally absent; a second opener must be refused.
+	if _, err := Open(anchor, dir, 2); err == nil {
+		t.Fatal("second process accepted on the same lock inode")
+	}
+}
