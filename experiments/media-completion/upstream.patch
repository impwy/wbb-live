+func TestCapacityDoesNotEraseTombstones(t *testing.T) {
+	r := newMemoryRegistry("slot-a", "epoch-a", 1)
+	if got := r.CloseOperation("a"); got.State != Completed {
+		t.Fatalf("first close = %s", got.State)
+	}
+	if got := r.CloseOperation("b"); got.State != CapacityUnknown {
+		t.Fatalf("saturated close = %s", got.State)
+	}
+	if got := r.Query("a"); got.State != Completed {
+		t.Fatalf("tombstone lost: %s", got.State)
+	}
+}
