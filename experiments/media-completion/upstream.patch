@@ -0,0 +1,79 @@
+package wbbcompletion
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+const testOperationID = "7b639209-c934-4a9d-84e1-eed077b1a765"
+
+func TestInternalHTTPAndPublishTuple(t *testing.T) {
+	r := newMemoryRegistry("slot-a", "epoch-a", 3)
+	key := bytes.Repeat([]byte{0x31}, 32)
+	h, err := NewHTTP(r, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	get := httptest.NewRequest(http.MethodGet, "/v3/wbb/lifecycle", nil)
+	get.Header.Set("X-WBB-Signature", Sign(key, "lifecycle", r.Root(), r.Slot(), "", ""))
+	w := httptest.NewRecorder()
+	h.Handler().ServeHTTP(w, get)
+	if w.Code != 200 {
+		t.Fatalf("lifecycle status %d", w.Code)
+	}
+	var lifecycle Snapshot
+	if err := json.Unmarshal(w.Body.Bytes(), &lifecycle); err != nil {
+		t.Fatal(err)
+	}
+	if lifecycle.Epoch != "epoch-a" || lifecycle.Root != "test-root" || lifecycle.ContractVersion != ContractVersion {
+		t.Fatal("lifecycle tuple omitted")
+	}
+
+	offer := []byte("fixed-sdp")
+	req := httptest.NewRequest(http.MethodPost, "/wbb/one/1/source/whip", bytes.NewReader(offer))
+	req.Header.Set("X-WBB-Operation", testOperationID)
+	req.Header.Set("X-WBB-Slot", r.Slot())
+	req.Header.Set("X-WBB-Root", r.Root())
+	req.Header.Set("X-WBB-Epoch", r.Epoch())
+	req.Header.Set("X-WBB-Signature", Sign(key, "publish", r.Root(), r.Slot(), r.Epoch(), testOperationID, "wbb/one/1/source", OfferDigest(offer)))
+	if id, err := r.VerifyPublish(req, key, "wbb/one/1/source", offer); err != nil || id != testOperationID {
+		t.Fatalf("valid tuple rejected: %v", err)
+	}
+	if _, err := r.VerifyPublish(req, key, "wbb/other/1/source", offer); err == nil {
+		t.Fatal("different path accepted")
+	}
+	if _, err := r.VerifyPublish(req, key, "wbb/one/1/source", []byte("changed")); err == nil {
+		t.Fatal("different SDP accepted")
+	}
+	req.Header.Set("X-WBB-Epoch", "epoch-b")
+	if _, err := r.VerifyPublish(req, key, "wbb/one/1/source", offer); err == nil {
+		t.Fatal("different epoch accepted")
+	}
+}
+
+func TestBarrierSignatureBoundToEpoch(t *testing.T) {
+	r := newMemoryRegistry("slot-a", "epoch-b", 2)
+	r.EnableBarriers()
+	key := bytes.Repeat([]byte{0x32}, 32)
+	h, _ := NewHTTP(r, key)
+	url := "/v3/wbb/barriers/before_register/" + testOperationID + "/arm"
+	request := func(epoch string) *http.Request {
+		req := httptest.NewRequest(http.MethodPost, url, nil)
+		req.Header.Set("X-WBB-Epoch", epoch)
+		req.Header.Set("X-WBB-Signature", Sign(key, "barrier-arm", r.Root(), r.Slot(), epoch, BeforeRegister, testOperationID))
+		return req
+	}
+	w := httptest.NewRecorder()
+	h.Handler().ServeHTTP(w, request("epoch-a"))
+	if w.Code != http.StatusUnauthorized {
+		t.Fatalf("old epoch arm status %d", w.Code)
+	}
+	w = httptest.NewRecorder()
+	h.Handler().ServeHTTP(w, request("epoch-b"))
+	if w.Code != http.StatusOK {
+		t.Fatalf("current epoch arm status %d", w.Code)
+	}
+}
diff --git a/internal/wbbcompletion/registry.go b/internal/wbbcompletion/registry.go
new file mode 100644
index 0000000..e14fb9e
--- /dev/null
+++ b/internal/wbbcompletion/registry.go
@@ -0,0 +1,529 @@
+// Package wbbcompletion is an isolated, Linux-only experiment for proving
+// completion of a MediaMTX publish operation. It is not a public API.
+package wbbcompletion
+
+import (
+	"bytes"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sync"
+	"syscall"
+	"time"
+)
+
+type State string
+
+const ContractVersion = "wbb-media-completion/1"
+
+const (
+	Active          State = "active"
+	NeverRegistered State = "never-registered"
+	Closing         State = "closing"
+	Completed       State = "completed"
+	UnknownEpoch    State = "unknown_epoch"
+	CapacityUnknown State = "capacity_unknown"
+)
+
+var (
+	ErrClosed    = errors.New("operation closed")
+	ErrDuplicate = errors.New("operation already registered")
+	ErrConflict  = errors.New("operation tuple conflict")
+	ErrCapacity  = errors.New("operation registry full")
+)
+
+type Snapshot struct {
+	ContractVersion string `json:"contract_version"`
+	Slot            string `json:"slot"`
+	Root            string `json:"root"`
+	Epoch           string `json:"epoch"`
+	EpochSequence   uint64 `json:"epoch_sequence"`
+	Operation       string `json:"operation"`
+	State           State  `json:"state"`
+	Registered      bool   `json:"registered"`
+	Sequence        uint64 `json:"sequence"`
+}
+
+type anchor struct {
+	Slot string `json:"slot"`
+	Root string `json:"root"`
+}
+
+type history struct {
+	Slot      string        `json:"slot"`
+	Root      string        `json:"root"`
+	LockDev   uint64        `json:"lock_dev"`
+	LockIno   uint64        `json:"lock_ino"`
+	LockToken string        `json:"lock_token"`
+	Epochs    []epochRecord `json:"epochs"`
+	Checksum  string        `json:"checksum,omitempty"`
+}
+
+type epochRecord struct {
+	ID       string `json:"id"`
+	Sequence uint64 `json:"sequence"`
+}
+
+type operation struct {
+	path, digest string
+	registered   bool
+	closing      bool
+	refs         int
+	stop         func()
+}
+
+// Registry is owned by the MediaMTX OS process. Its lock FD is deliberately
+// never closed on the accepted path: a graceful shutdown cannot release proof
+// while an unjoined handler or child is still running.
+type Registry struct {
+	mu            sync.Mutex
+	slot          string
+	root          string
+	epoch         string
+	epochSequence uint64
+	seq           uint64
+	capacity      int
+	ops           map[string]*operation
+	lockFD        *os.File
+	history       history
+	barriers      barriers
+}
+
+var processLocks struct {
+	sync.Mutex
+	files []*os.File
+}
+
+// faultPause is available only in the isolated barrier-enabled experiment.
+// A separate verifier observes the marker, then kills the actual Linux OS
+// process at a persistence boundary. It is never enabled by normal startup.
+func faultPause(stage string) error {
+	if os.Getenv("WBB_COMPLETION_BARRIERS") != "1" || os.Getenv("WBB_COMPLETION_FAULT_STAGE") != stage {
+		return nil
+	}
+	marker := os.Getenv("WBB_COMPLETION_FAULT_MARKER")
+	if marker == "" {
+		return errors.New("fault marker unavailable")
+	}
+	if err := os.WriteFile(marker, []byte(stage), 0600); err != nil {
+		return err
+	}
+	for {
+		time.Sleep(time.Hour)
+	}
+}
+
+func loadAnchor(path string) (anchor, error) {
+	var a anchor
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return a, err
+	}
+	if err = json.Unmarshal(b, &a); err != nil {
+		return a, err
+	}
+	if a.Slot == "" || a.Root == "" {
+		return a, errors.New("incomplete bootstrap anchor")
+	}
+	return a, nil
+}
+
+func statLock(f *os.File) (uint64, uint64, error) {
+	fi, err := f.Stat()
+	if err != nil {
+		return 0, 0, err
+	}
+	s, ok := fi.Sys().(*syscall.Stat_t)
+	if !ok {
+		return 0, 0, errors.New("lock inode unavailable")
+	}
+	return uint64(s.Dev), uint64(s.Ino), nil
+}
+
+func writeAtomic(dir, name string, v any) error {
+	b, err := json.Marshal(v)
+	if err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(dir, ".wbb-history-*")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(f.Name())
+	if _, err = f.Write(b); err != nil {
+		f.Close()
+		return err
+	}
+	if err = f.Sync(); err != nil {
+		f.Close()
+		return err
+	}
+	if err = faultPause("after_file_sync"); err != nil {
+		f.Close()
+		return err
+	}
+	if err = f.Close(); err != nil {
+		return err
+	}
+	if err = os.Rename(f.Name(), filepath.Join(dir, name)); err != nil {
+		return err
+	}
+	if err = faultPause("after_rename"); err != nil {
+		return err
+	}
+	d, err := os.Open(dir)
+	if err != nil {
+		return err
+	}
+	defer d.Close()
+	if err = d.Sync(); err != nil {
+		return err
+	}
+	return faultPause("after_dir_sync")
+}
+
+// The checksum detects accidental edits to the exact persisted history. It
+// does not authenticate the volume or protect against a copied old snapshot.
+func historyChecksum(h history) (string, error) {
+	h.Checksum = ""
+	b, err := json.Marshal(h)
+	if err != nil {
+		return "", err
+	}
+	sum := sha256.Sum256(b)
+	return hex.EncodeToString(sum[:]), nil
+}
+
+func writeHistoryAtomic(dir string, h *history) error {
+	checksum, err := historyChecksum(*h)
+	if err != nil {
+		return err
+	}
+	h.Checksum = checksum
+	return writeAtomic(dir, "history.json", h)
+}
+
+// Bootstrap is an explicit, one-shot provisioning action. Normal Open never
+// creates an empty history; deleting the volume therefore fails closed.
+func Bootstrap(anchorPath, dir string) error {
+	a, err := loadAnchor(anchorPath)
+	if err != nil {
+		return err
+	}
+	if err = os.MkdirAll(dir, 0700); err != nil {
+		return err
+	}
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return err
+	}
+	if len(entries) != 0 {
+		return errors.New("bootstrap directory is not empty")
+	}
+	f, err := os.OpenFile(filepath.Join(dir, "lock"), os.O_CREATE|os.O_EXCL|os.O_RDWR, 0600)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	if err = syscall.Flock(int(f.Fd()), syscall.LOCK_EX|syscall.LOCK_NB); err != nil {
+		return err
+	}
+	dev, ino, err := statLock(f)
+	if err != nil {
+		return err
+	}
+	lockToken := RandomID()
+	if _, err = f.WriteString(lockToken); err != nil {
+		return err
+	}
+	if err = f.Sync(); err != nil {
+		return err
+	}
+	h := history{Slot: a.Slot, Root: a.Root, LockDev: dev, LockIno: ino, LockToken: lockToken, Epochs: []epochRecord{}}
+	return writeHistoryAtomic(dir, &h)
+}
+
+func readHistory(path string, a anchor, lock *os.File) (history, error) {
+	var h history
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return h, err
+	}
+	if err = json.Unmarshal(b, &h); err != nil {
+		return h, err
+	}
+	canonical, err := json.Marshal(h)
+	if err != nil {
+		return h, err
+	}
+	if !bytes.Equal(b, canonical) {
+		return h, errors.New("history encoding mismatch")
+	}
+	checksum, err := historyChecksum(h)
+	if err != nil {
+		return h, err
+	}
+	if len(h.Checksum) != 64 || h.Checksum != checksum {
+		return h, errors.New("history checksum mismatch")
+	}
+	dev, ino, err := statLock(lock)
+	if err != nil {
+		return h, err
+	}
+	info, err := lock.Stat()
+	if err != nil {
+		return h, err
+	}
+	lockBytes := make([]byte, 32)
+	if _, err = lock.ReadAt(lockBytes, 0); err != nil {
+		return h, err
+	}
+	if h.Slot != a.Slot || h.Root != a.Root || h.LockDev != dev || h.LockIno != ino ||
+		len(h.LockToken) != 32 || info.Size() != 32 || h.LockToken != string(lockBytes) || h.Epochs == nil {
+		return h, errors.New("bootstrap anchor, slot, or lock inode mismatch")
+	}
+	seen := make(map[string]bool, len(h.Epochs))
+	for i, epoch := range h.Epochs {
+		if epoch.Sequence != uint64(i+1) || len(epoch.ID) != 32 || seen[epoch.ID] {
+			return h, errors.New("epoch history discontinuity")
+		}
+		seen[epoch.ID] = true
+	}
+	return h, nil
+}
+
+// Open validates immutable history on both sides of the same-inode flock,
+// persists the next epoch, and only then permits requests.
+func Open(anchorPath, dir string, capacity int) (_ *Registry, err error) {
+	if capacity < 1 {
+		return nil, errors.New("capacity must be positive")
+	}
+	a, err := loadAnchor(anchorPath)
+	if err != nil {
+		return nil, err
+	}
+	lockPath := filepath.Join(dir, "lock")
+	f, err := os.OpenFile(lockPath, os.O_RDWR, 0)
+	if err != nil {
+		return nil, err
+	}
+	accepted := false
+	defer func() {
+		if !accepted {
+			f.Close()
+		}
+	}()
+	path := filepath.Join(dir, "history.json")
+	if _, err = readHistory(path, a, f); err != nil {
+		return nil, err
+	}
+	if err = faultPause("before_lock"); err != nil {
+		return nil, err
+	}
+	if err = syscall.Flock(int(f.Fd()), syscall.LOCK_EX|syscall.LOCK_NB); err != nil {
+		return nil, err
+	}
+	if err = faultPause("after_lock"); err != nil {
+		return nil, err
+	}
+	h, err := readHistory(path, a, f)
+	if err != nil {
+		return nil, err
+	}
+	current, err := os.Stat(lockPath)
+	if err != nil {
+		return nil, err
+	}
+	opened, err := f.Stat()
+	if err != nil {
+		return nil, err
+	}
+	if !os.SameFile(current, opened) {
+		return nil, errors.New("lock path replaced")
+	}
+	epochID := RandomID()
+	for _, previous := range h.Epochs {
+		if previous.ID == epochID {
+			return nil, errors.New("epoch id collision")
+		}
+	}
+	h.Epochs = append(h.Epochs, epochRecord{ID: epochID, Sequence: uint64(len(h.Epochs) + 1)})
+	if err = faultPause("before_history_write"); err != nil {
+		return nil, err
+	}
+	if err = writeHistoryAtomic(dir, &h); err != nil {
+		return nil, err
+	}
+	if err = faultPause("before_accept"); err != nil {
+		return nil, err
+	}
+	r := &Registry{slot: a.Slot, root: a.Root, epoch: epochID, epochSequence: uint64(len(h.Epochs)), capacity: capacity, ops: make(map[string]*operation), lockFD: f, history: h}
+	processLocks.Lock()
+	processLocks.files = append(processLocks.files, f)
+	processLocks.Unlock()
+	accepted = true
+	return r, nil
+}
+
+func newMemoryRegistry(slot string, epoch string, capacity int) *Registry {
+	return &Registry{slot: slot, root: "test-root", epoch: epoch, epochSequence: 1, capacity: capacity, ops: make(map[string]*operation)}
+}
+
+func (r *Registry) Epoch() string { return r.epoch }
+func (r *Registry) Slot() string  { return r.slot }
+func (r *Registry) Root() string  { return r.root }
+
+func (r *Registry) Lifecycle() Snapshot {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return Snapshot{ContractVersion: ContractVersion, Slot: r.slot, Root: r.root, Epoch: r.epoch, EpochSequence: r.epochSequence, Sequence: r.seq}
+}
+
+func (r *Registry) Begin(id, path, digest string) (*Operation, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if id == "" || path == "" || digest == "" {
+		return nil, ErrConflict
+	}
+	if old, ok := r.ops[id]; ok {
+		if old.registered && (old.path != path || old.digest != digest) {
+			return nil, ErrConflict
+		}
+		if old.closing {
+			return nil, ErrClosed
+		}
+		return nil, ErrDuplicate
+	}
+	if len(r.ops) >= r.capacity {
+		return nil, ErrCapacity
+	}
+	r.ops[id] = &operation{path: path, digest: digest, registered: true, refs: 1}
+	r.seq++
+	return &Operation{registry: r, id: id}, nil
+}
+
+type Operation struct {
+	registry *Registry
+	id       string
+}
+
+func (o *Operation) ID() string { return o.id }
+
+func (o *Operation) WaitBarrier(stage string) error { return o.registry.WaitBarrier(stage, o.id) }
+
+func (o *Operation) IsClosing() bool {
+	r := o.registry
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.ops[o.id].closing
+}
+
+func (o *Operation) AttachSession(stop func()) {
+	r := o.registry
+	r.mu.Lock()
+	op := r.ops[o.id]
+	op.refs++
+	op.stop = stop
+	closing := op.closing
+	r.mu.Unlock()
+	if closing {
+		stop()
+	}
+}
+
+func (o *Operation) done() {
+	r := o.registry
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	op := r.ops[o.id]
+	if op.refs <= 0 {
+		panic("operation refcount underflow")
+	}
+	op.refs--
+	if op.refs == 0 {
+		op.stop = nil
+	}
+	r.seq++
+}
+
+func (o *Operation) DoneCreation() { o.done() }
+func (o *Operation) DoneSession()  { o.done() }
+
+func (r *Registry) snapshotLocked(id string) Snapshot {
+	s := Snapshot{ContractVersion: ContractVersion, Slot: r.slot, Root: r.root, Epoch: r.epoch, EpochSequence: r.epochSequence, Operation: id, State: NeverRegistered, Sequence: r.seq}
+	if op, ok := r.ops[id]; ok {
+		s.Registered = op.registered
+		switch {
+		case op.closing && op.refs == 0:
+			s.State = Completed
+		case op.closing:
+			s.State = Closing
+		default:
+			s.State = Active
+		}
+	}
+	return s
+}
+
+func (r *Registry) Query(id string) Snapshot {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.snapshotLocked(id)
+}
+
+func (r *Registry) QueryEpoch(epoch string, id string) Snapshot {
+	if epoch == r.epoch {
+		return r.Query(id)
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	s := Snapshot{ContractVersion: ContractVersion, Slot: r.slot, Root: r.root, Epoch: epoch, Operation: id, State: UnknownEpoch, Sequence: r.seq}
+	for _, previous := range r.history.Epochs {
+		if previous.ID == epoch && previous.Sequence < r.epochSequence {
+			s.State = Completed
+			s.EpochSequence = previous.Sequence
+			break
+		}
+	}
+	return s
+}
+
+func (r *Registry) CloseOperation(id string) Snapshot {
+	r.mu.Lock()
+	op, ok := r.ops[id]
+	if !ok && len(r.ops) >= r.capacity {
+		s := Snapshot{ContractVersion: ContractVersion, Slot: r.slot, Root: r.root, Epoch: r.epoch, EpochSequence: r.epochSequence, Operation: id, State: CapacityUnknown, Sequence: r.seq}
+		r.mu.Unlock()
+		return s
+	}
+	if !ok {
+		op = &operation{closing: true}
+		r.ops[id] = op
+		r.seq++
+	}
+	if !op.closing {
+		op.closing = true
+		r.seq++
+	}
+	stop := op.stop
+	s := r.snapshotLocked(id)
+	r.mu.Unlock()
+	if stop != nil {
+		stop()
+	}
+	return s
+}
+
+// RandomID is for isolated bootstrap and tests, not a credential.
+func RandomID() string {
+	var b [16]byte
+	if _, err := rand.Read(b[:]); err != nil {
+		panic(fmt.Errorf("random id: %w", err))
+	}
+	return hex.EncodeToString(b[:])
+}
