+package wbbcompletion
+
+import (
+	"encoding/json"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestKilledProcessAtPersistenceBoundaries(t *testing.T) {
+	for _, ca := range []struct {
+		stage     string
+		persisted int
+	}{
+		{"before_lock", 0},
+		{"after_lock", 0},
+		{"before_history_write", 0},
+		{"after_file_sync", 0},
+		{"after_rename", 1},
+		{"after_dir_sync", 1},
+		{"before_accept", 1},
+	} {
+		t.Run(ca.stage, func(t *testing.T) {
+			dir := t.TempDir()
+			anchor := filepath.Join(t.TempDir(), "anchor")
+			if err := os.WriteFile(anchor, []byte(`{"slot":"s","root":"r"}`), 0600); err != nil {
+				t.Fatal(err)
+			}
+			if err := Bootstrap(anchor, dir); err != nil {
+				t.Fatal(err)
+			}
+			faultMarker := filepath.Join(t.TempDir(), "fault")
+			resultMarker := filepath.Join(t.TempDir(), "result")
+			cmd := exec.Command(os.Args[0], "-test.run=^TestEpochProcessHelper$")
+			cmd.Env = append(os.Environ(),
+				"WBB_EPOCH_HELPER=1", "WBB_ANCHOR="+anchor, "WBB_HISTORY_DIR="+dir, "WBB_MARKER="+resultMarker,
+				"WBB_COMPLETION_BARRIERS=1", "WBB_COMPLETION_FAULT_STAGE="+ca.stage, "WBB_COMPLETION_FAULT_MARKER="+faultMarker)
+			if err := cmd.Start(); err != nil {
+				t.Fatal(err)
+			}
+			defer func() {
+				if cmd.ProcessState == nil {
+					cmd.Process.Kill()
+					cmd.Wait()
+				}
+			}()
+			deadline := time.Now().Add(3 * time.Second)
+			var marker []byte
+			for time.Now().Before(deadline) {
+				marker, _ = os.ReadFile(faultMarker)
+				if string(marker) == ca.stage {
+					break
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+			if string(marker) != ca.stage {
+				t.Fatal("child did not reach persistence boundary")
+			}
+			if ca.stage != "before_lock" {
+				if _, err := Open(anchor, dir, 2); err == nil {
+					t.Fatal("second process acquired live lock")
+				}
+			}
+			if err := cmd.Process.Kill(); err != nil {
+				t.Fatal(err)
+			}
+			if err := cmd.Wait(); err == nil {
+				t.Fatal("child was not killed")
+			}
+			var h history
+			encoded, err := os.ReadFile(filepath.Join(dir, "history.json"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := json.Unmarshal(encoded, &h); err != nil {
+				t.Fatal(err)
+			}
+			if len(h.Epochs) != ca.persisted {
+				t.Fatalf("persisted epochs=%d want=%d", len(h.Epochs), ca.persisted)
+			}
+			r, err := Open(anchor, dir, 2)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if r.Lifecycle().EpochSequence != uint64(ca.persisted+1) {
+				t.Fatal("restart sequence mismatch")
+			}
+			if ca.persisted == 1 && r.QueryEpoch(h.Epochs[0].ID, "old").State != Completed {
+				t.Fatal("persisted killed epoch not retired")
+			}
+		})
+	}
+}
+
+func TestExistingHistoryIntegrityRejectsWithoutRewrite(t *testing.T) {
+	for _, scenario := range []string{"empty", "missing_history", "corrupt_history", "extra_json_field", "wrong_slot", "wrong_root", "replaced_lock", "modified_lock_contents"} {
+		t.Run(scenario, func(t *testing.T) {
+			dir := t.TempDir()
+			anchor := filepath.Join(t.TempDir(), "anchor")
+			if err := os.WriteFile(anchor, []byte(`{"slot":"s","root":"r"}`), 0600); err != nil {
+				t.Fatal(err)
+			}
+			if scenario != "empty" {
+				if err := Bootstrap(anchor, dir); err != nil {
+					t.Fatal(err)
+				}
+			}
+			var before []byte
+			var err error
+			historyPath := filepath.Join(dir, "history.json")
+			switch scenario {
+			case "missing_history":
+				if err := os.Remove(historyPath); err != nil {
+					t.Fatal(err)
+				}
+			case "corrupt_history":
+				if err := os.WriteFile(historyPath, []byte("{"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			case "extra_json_field":
+				original, err := os.ReadFile(historyPath)
+				if err != nil {
+					t.Fatal(err)
+				}
+				withExtra := append(append([]byte(nil), original[:len(original)-1]...), []byte(`,"extra":1}`)...)
+				if err := os.WriteFile(historyPath, withExtra, 0600); err != nil {
+					t.Fatal(err)
+				}
+			case "wrong_slot":
+				if err := os.WriteFile(anchor, []byte(`{"slot":"other","root":"r"}`), 0600); err != nil {
+					t.Fatal(err)
+				}
+			case "wrong_root":
+				if err := os.WriteFile(anchor, []byte(`{"slot":"s","root":"other"}`), 0600); err != nil {
+					t.Fatal(err)
+				}
+			case "replaced_lock":
+				oldLock, err := os.Open(filepath.Join(dir, "lock"))
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer oldLock.Close() // keep the old inode allocated during replacement
+				if err := os.Remove(filepath.Join(dir, "lock")); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.WriteFile(filepath.Join(dir, "lock"), nil, 0600); err != nil {
+					t.Fatal(err)
+				}
+				oldInfo, err := oldLock.Stat()
+				if err != nil {
+					t.Fatal(err)
+				}
+				newInfo, err := os.Stat(filepath.Join(dir, "lock"))
+				if err != nil {
+					t.Fatal(err)
+				}
+				if os.SameFile(oldInfo, newInfo) {
+					t.Fatal("replacement did not change inode")
+				}
+			case "modified_lock_contents":
+				if err := os.WriteFile(filepath.Join(dir, "lock"), []byte("00000000000000000000000000000000"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			before, err = os.ReadFile(historyPath)
+			if scenario == "empty" || scenario == "missing_history" {
+				if !os.IsNotExist(err) {
+					t.Fatal("missing history unexpectedly present")
+				}
+			} else if err != nil {
+				t.Fatal(err)
+			}
+			if _, err := Open(anchor, dir, 2); err == nil {
+				t.Fatal("invalid history accepted")
+			}
+			after, afterErr := os.ReadFile(historyPath)
+			if scenario == "empty" || scenario == "missing_history" {
+				if !os.IsNotExist(afterErr) {
+					t.Fatal("invalid volume was initialized")
+				}
+			} else if afterErr != nil || string(after) != string(before) {
+				t.Fatal("invalid history was rewritten")
+			}
+		})
+	}
+}
+
+func TestHistoryChecksumRejectsWellFormedEpochMutation(t *testing.T) {
+	dir := t.TempDir()
+	anchorPath := filepath.Join(t.TempDir(), "anchor")
+	if err := os.WriteFile(anchorPath, []byte(`{"slot":"s","root":"r"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := Bootstrap(anchorPath, dir); err != nil {
+		t.Fatal(err)
+	}
+	marker := filepath.Join(t.TempDir(), "accepted")
+	cmd := exec.Command(os.Args[0], "-test.run=^TestEpochProcessHelper$")
+	cmd.Env = append(os.Environ(), "WBB_EPOCH_HELPER=1", "WBB_ANCHOR="+anchorPath, "WBB_HISTORY_DIR="+dir, "WBB_MARKER="+marker)
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if cmd.ProcessState == nil {
+			cmd.Process.Kill()
+			cmd.Wait()
+		}
+	}()
+	deadline := time.Now().Add(3 * time.Second)
+	for time.Now().Before(deadline) {
+		if b, _ := os.ReadFile(marker); len(b) > 0 {
+			break
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	if b, _ := os.ReadFile(marker); len(b) == 0 {
+		t.Fatal("child never accepted epoch")
+	}
+	if err := cmd.Process.Kill(); err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Wait(); err == nil {
+		t.Fatal("child was not killed")
+	}
+	path := filepath.Join(dir, "history.json")
+	encoded, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var h history
+	if err := json.Unmarshal(encoded, &h); err != nil {
+		t.Fatal(err)
+	}
+	if h.Epochs[0].ID[0] == '0' {
+		h.Epochs[0].ID = "1" + h.Epochs[0].ID[1:]
+	} else {
+		h.Epochs[0].ID = "0" + h.Epochs[0].ID[1:]
+	}
+	corrupted, err := json.Marshal(h)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, corrupted, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Open(anchorPath, dir, 2); err == nil {
+		t.Fatal("well-formed corrupted history accepted")
+	}
+	after, err := os.ReadFile(path)
+	if err != nil || string(after) != string(corrupted) {
+		t.Fatal("rejected history was rewritten")
+	}
+}
