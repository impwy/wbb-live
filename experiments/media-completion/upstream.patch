+// The completion experiment only supports WHIP publishing and HLS reading.
+// In particular, a second publishing protocol or dynamic configuration could
+// create untracked media effects outside the operation registry.
+func validateCompletionConf(c *conf.Conf) error {
+	if runtime.GOOS != "linux" {
+		return fmt.Errorf("Linux is required")
+	}
+	// The upstream HTTP debug logger records SDP/ICE credentials verbatim.
+	// Completion credentials and media offers must never enter those logs.
+	if c.LogLevel == conf.LogLevel(logger.Debug) || c.DumpPackets {
+		return fmt.Errorf("debug logging and packet dumps are unsupported in completion mode")
+	}
+	if !c.WebRTC || !c.HLS || !c.API || !c.RTSP || c.RTMP || c.SRT || c.MoQ || c.Playback ||
+		c.AuthMethod != conf.AuthMethodHTTP || c.AuthHTTPAddress == "" || len(c.AuthHTTPExclude) != 0 ||
+		c.RunOnConnect != "" || c.RunOnDisconnect != "" {
+		return fmt.Errorf("unsupported server or global hook")
+	}
+	checkPath := func(p *conf.Path) bool {
+		return p != nil && p.Source == "publisher" && !p.OverridePublisher && !p.Record &&
+			!p.AlwaysAvailable && len(p.Forward) == 0 &&
+			p.RunOnInit == "" && p.RunOnDemand == "" && p.RunOnUnDemand == "" &&
+			p.RunOnAvailable == "" && p.RunOnUnavailable == "" && p.RunOnOnline == "" &&
+			p.RunOnOffline == "" && p.RunOnRead == "" && p.RunOnUnread == "" &&
+			p.RunOnRecordSegmentCreate == "" && p.RunOnRecordSegmentComplete == ""
+	}
+	if !checkPath(&c.PathDefaults) {
+		return fmt.Errorf("unsupported path defaults")
+	}
+	for _, p := range c.Paths {
+		if !checkPath(p) {
+			return fmt.Errorf("unsupported path configuration")
+		}
+	}
+	return nil
+}
