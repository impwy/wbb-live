+func TestCloseBeforeCreateAndDuplicate(t *testing.T) {
+	r := newMemoryRegistry("slot-a", "epoch-a", 2)
+	if got := r.Query("never"); got.State != NeverRegistered {
+		t.Fatalf("never state = %s", got.State)
+	}
+	if got := r.CloseOperation("a"); got.State != Completed {
+		t.Fatalf("pre-create close = %s", got.State)
+	}
+	if _, err := r.Begin("a", "path", "digest"); err == nil {
+		t.Fatal("closed operation recreated")
+	}
+	op, err := r.Begin("b", "path", "digest")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := r.Begin("b", "path", "digest"); err == nil {
+		t.Fatal("duplicate created a second session")
+	}
+	if _, err := r.Begin("b", "other", "digest"); err == nil {
+		t.Fatal("conflicting operation accepted")
+	}
+	if got := r.CloseOperation("b"); got.State != Closing {
+		t.Fatalf("close while handler active = %s", got.State)
+	}
+	op.DoneCreation()
+	if got := r.Query("b"); got.State != Completed {
+		t.Fatalf("completion = %s", got.State)
+	}
+}
