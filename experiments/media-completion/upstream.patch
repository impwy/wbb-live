+func TestCloseRaceWithSessionAttach(t *testing.T) {
+	r := newMemoryRegistry("slot-a", "epoch-a", 2)
+	op, err := r.Begin("a", "path", "digest")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	wg.Add(1)
+	stopped := make(chan struct{})
+	go func() { defer wg.Done(); r.CloseOperation("a") }()
+	op.AttachSession(func() { close(stopped) })
+	select {
+	case <-stopped:
+	case <-time.After(time.Second):
+		t.Fatal("late attach was not cancelled")
+	}
+	if s := r.Query("a"); s.State != Closing {
+		t.Fatalf("completed before session exit: %s", s.State)
+	}
+	op.DoneCreation()
+	if s := r.Query("a"); s.State != Closing {
+		t.Fatalf("completed before session exit: %s", s.State)
+	}
+	op.DoneSession()
+	wg.Wait()
+	if s := r.Query("a"); s.State != Completed {
+		t.Fatalf("session not completed: %s", s.State)
+	}
+}
