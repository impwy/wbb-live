+func TestCompletionICEBindFailureNeverAcceptsWHIP(t *testing.T) {
+	udp, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer udp.Close()
+	httpReservation, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	httpAddress := httpReservation.Addr().String()
+	require.NoError(t, httpReservation.Close())
+
+	s := &Server{
+		Address:         httpAddress,
+		LocalUDPAddress: udp.LocalAddr().String(),
+		Parent:          test.NilLogger,
+	}
+	require.Error(t, s.Initialize())
+	conn, err := net.DialTimeout("tcp", httpAddress, 100*time.Millisecond)
+	if err == nil {
+		conn.Close()
+	}
+	require.Error(t, err, "WHIP accepted requests despite failed ICE initialization")
+}
+
+func TestCompletionTCPBindFailureReleasesUDPWithoutAcceptingWHIP(t *testing.T) {
+	tcp, err := net.Listen("tcp", "127.0.0.1:0")
