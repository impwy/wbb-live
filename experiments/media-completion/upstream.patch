+func TestKilledProcessEpochAtoBtoC(t *testing.T) {
+	dir := t.TempDir()
+	anchor := filepath.Join(t.TempDir(), "anchor")
+	if err := os.WriteFile(anchor, []byte(`{"slot":"s","root":"r"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := Bootstrap(anchor, dir); err != nil {
+		t.Fatal(err)
+	}
+	start := func(name string) string {
+		marker := filepath.Join(t.TempDir(), name)
+		cmd := exec.Command(os.Args[0], "-test.run=^TestEpochProcessHelper$")
+		cmd.Env = append(os.Environ(), "WBB_EPOCH_HELPER=1", "WBB_ANCHOR="+anchor, "WBB_HISTORY_DIR="+dir, "WBB_MARKER="+marker)
+		if err := cmd.Start(); err != nil {
+			t.Fatal(err)
+		}
+		deadline := time.Now().Add(3 * time.Second)
+		var b []byte
+		for time.Now().Before(deadline) {
+			b, _ = os.ReadFile(marker)
+			if len(b) > 0 {
+				break
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+		if len(b) == 0 {
+			cmd.Process.Kill()
+			cmd.Wait()
+			t.Fatal("child did not accept epoch")
+		}
+		if _, err := Open(anchor, dir, 2); err == nil {
+			cmd.Process.Kill()
+			cmd.Wait()
+			t.Fatal("concurrent lock accepted")
+		}
+		if err := cmd.Process.Kill(); err != nil {
+			t.Fatal(err)
+		}
+		if err := cmd.Wait(); err == nil {
+			t.Fatal("expected killed child")
+		}
+		return string(b)
+	}
+	a := start("a")
+	b := start("b")
+	c, err := Open(anchor, dir, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if a == b || b == c.Epoch() || a == c.Epoch() || c.Lifecycle().EpochSequence != 3 {
+		t.Fatal("epoch was reused or sequence skipped")
+	}
+	if got := c.QueryEpoch(a, "old"); got.State != Completed || got.EpochSequence != 1 {
+		t.Fatalf("A not retired: %+v", got)
+	}
+	if got := c.QueryEpoch("not-in-history", "old"); got.State != UnknownEpoch {
+		t.Fatalf("unknown epoch accepted: %s", got.State)
+	}
+}
