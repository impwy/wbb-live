diff --git a/internal/wbbcompletion/barrier.go b/internal/wbbcompletion/barrier.go
new file mode 100644
index 0000000..98e89eb
--- /dev/null
+++ b/internal/wbbcompletion/barrier.go
@@ -0,0 +1,129 @@
+package wbbcompletion
+
+import (
+	"errors"
+	"sync"
+)
+
+const (
+	BeforeRegister           = "before_register"
+	BeforeSessionInitialize  = "before_session_initialize"
+	DuringAuth               = "during_auth"
+	BeforeAddPublisher       = "before_add_publisher"
+	BeforeCompletionResponse = "before_completion_response"
+	DuringRTPCallback        = "during_rtp_callback"
+	DuringPLI                = "during_pli"
+	DuringICEPatch           = "during_ice_patch"
+)
+
+type gate struct {
+	release chan struct{}
+	arrived bool
+}
+
+type BarrierState struct {
+	Armed   bool `json:"armed"`
+	Arrived bool `json:"arrived"`
+}
+
+type barriers struct {
+	sync.Mutex
+	enabled bool
+	gates   map[string]*gate
+	abort   chan struct{}
+	aborted bool
+}
+
+func (r *Registry) EnableBarriers() {
+	r.barriers.Lock()
+	r.barriers.enabled = true
+	r.barriers.gates = make(map[string]*gate)
+	r.barriers.abort = make(chan struct{})
+	r.barriers.aborted = false
+	r.barriers.Unlock()
+}
+
+func validStage(stage string) bool {
+	switch stage {
+	case BeforeRegister, BeforeSessionInitialize, DuringAuth, BeforeAddPublisher, BeforeCompletionResponse,
+		DuringRTPCallback, DuringPLI, DuringICEPatch:
+		return true
+	default:
+		return false
+	}
+}
+
+func barrierKey(stage, id string) string { return stage + "/" + id }
+
+func (r *Registry) ArmBarrier(stage, id string) error {
+	if !validStage(stage) || id == "" {
+		return errors.New("invalid barrier")
+	}
+	r.barriers.Lock()
+	defer r.barriers.Unlock()
+	if !r.barriers.enabled || r.barriers.aborted {
+		return errors.New("barriers disabled")
+	}
+	k := barrierKey(stage, id)
+	if _, ok := r.barriers.gates[k]; ok {
+		return errors.New("barrier already armed")
+	}
+	r.barriers.gates[k] = &gate{release: make(chan struct{})}
+	return nil
+}
+
+func (r *Registry) ReleaseBarrier(stage, id string) error {
+	r.barriers.Lock()
+	defer r.barriers.Unlock()
+	g, ok := r.barriers.gates[barrierKey(stage, id)]
+	if !ok {
+		return errors.New("barrier absent")
+	}
+	close(g.release)
+	delete(r.barriers.gates, barrierKey(stage, id))
+	return nil
+}
+
+func (r *Registry) BarrierStatus(stage, id string) BarrierState {
+	r.barriers.Lock()
+	defer r.barriers.Unlock()
+	g, ok := r.barriers.gates[barrierKey(stage, id)]
+	if !ok {
+		return BarrierState{}
+	}
+	return BarrierState{Armed: true, Arrived: g.arrived}
+}
+
+// Held work remains scheduled after operation cancellation. Only explicit
+// release or full experiment abort/process exit discharges it.
+func (r *Registry) WaitBarrier(stage, id string) error {
+	r.barriers.Lock()
+	g := r.barriers.gates[barrierKey(stage, id)]
+	if g != nil {
+		g.arrived = true
+	}
+	abort := r.barriers.abort
+	aborted := r.barriers.aborted
+	r.barriers.Unlock()
+	if aborted {
+		return errors.New("experiment barrier aborted")
+	}
+	if g == nil {
+		return nil
+	}
+	select {
+	case <-g.release:
+		return nil
+	case <-abort:
+		return errors.New("experiment barrier aborted")
+	}
+}
+
+func (r *Registry) AbortBarriers() {
+	r.barriers.Lock()
+	if r.barriers.enabled && !r.barriers.aborted {
+		close(r.barriers.abort)
+		r.barriers.aborted = true
+	}
+	r.barriers.Unlock()
+}
diff --git a/internal/wbbcompletion/http.go b/internal/wbbcompletion/http.go
new file mode 100644
index 0000000..aee38c3
--- /dev/null
+++ b/internal/wbbcompletion/http.go
@@ -0,0 +1,191 @@
+package wbbcompletion
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"crypto/subtle"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+)
+
+// Sign is the documented internal-only HMAC wire format used by the spike
+// harness. It is deliberately separate from MediaMTX's public path auth.
+func Sign(key []byte, parts ...string) string {
+	h := hmac.New(sha256.New, key)
+	for _, part := range parts {
+		h.Write([]byte(strconv.Itoa(len(part))))
+		h.Write([]byte{':'})
+		h.Write([]byte(part))
+	}
+	return hex.EncodeToString(h.Sum(nil))
+}
+
+func equalSignature(got, expected string) bool {
+	if len(got) != len(expected) {
+		return false
+	}
+	return subtle.ConstantTimeCompare([]byte(got), []byte(expected)) == 1
+}
+
+func (r *Registry) VerifyPublish(req *http.Request, key []byte, path string, offer []byte) (string, error) {
+	id := req.Header.Get("X-WBB-Operation")
+	if _, err := uuid.Parse(id); err != nil {
+		return "", errors.New("invalid operation")
+	}
+	if req.Header.Get("X-WBB-Slot") != r.slot || req.Header.Get("X-WBB-Root") != r.root || req.Header.Get("X-WBB-Epoch") != r.epoch {
+		return "", errors.New("wrong lifecycle")
+	}
+	digest := sha256.Sum256(offer)
+	expected := Sign(key, "publish", r.root, r.slot, r.epoch, id, path, hex.EncodeToString(digest[:]))
+	if !equalSignature(req.Header.Get("X-WBB-Signature"), expected) {
+		return "", errors.New("invalid signature")
+	}
+	return id, nil
+}
+
+func OfferDigest(offer []byte) string {
+	digest := sha256.Sum256(offer)
+	return hex.EncodeToString(digest[:])
+}
+
+type HTTP struct {
+	registry *Registry
+	key      []byte
+	server   *http.Server
+	listener net.Listener
+}
+
+func NewHTTP(registry *Registry, key []byte) (*HTTP, error) {
+	if registry == nil || len(key) < 32 {
+		return nil, errors.New("completion HTTP requires a registry and 32-byte key")
+	}
+	return &HTTP{registry: registry, key: append([]byte(nil), key...)}, nil
+}
+
+func (h *HTTP) authorized(req *http.Request, purpose, epoch, id string) bool {
+	return equalSignature(req.Header.Get("X-WBB-Signature"), Sign(h.key, purpose, h.registry.root, h.registry.slot, epoch, id))
+}
+
+func (h *HTTP) authorizedBarrier(req *http.Request, purpose, stage, id string) bool {
+	if req.Header.Get("X-WBB-Epoch") != h.registry.epoch {
+		return false
+	}
+	return equalSignature(req.Header.Get("X-WBB-Signature"), Sign(h.key, purpose, h.registry.root, h.registry.slot, h.registry.epoch, stage, id))
+}
+
+func (h *HTTP) Handler() http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("POST /v3/wbb/barriers/{stage}/{id}/arm", func(w http.ResponseWriter, req *http.Request) {
+		stage, id := req.PathValue("stage"), req.PathValue("id")
+		if !h.authorizedBarrier(req, "barrier-arm", stage, id) {
+			http.Error(w, "unauthorized", http.StatusUnauthorized)
+			return
+		}
+		if err := h.registry.ArmBarrier(stage, id); err != nil {
+			http.Error(w, "barrier unavailable", http.StatusConflict)
+			return
+		}
+		writeJSON(w, http.StatusOK, h.registry.BarrierStatus(stage, id))
+	})
+	mux.HandleFunc("POST /v3/wbb/barriers/{stage}/{id}/release", func(w http.ResponseWriter, req *http.Request) {
+		stage, id := req.PathValue("stage"), req.PathValue("id")
+		if !h.authorizedBarrier(req, "barrier-release", stage, id) {
+			http.Error(w, "unauthorized", http.StatusUnauthorized)
+			return
+		}
+		if err := h.registry.ReleaseBarrier(stage, id); err != nil {
+			http.Error(w, "barrier unavailable", http.StatusConflict)
+			return
+		}
+		writeJSON(w, http.StatusOK, BarrierState{})
+	})
+	mux.HandleFunc("GET /v3/wbb/barriers/{stage}/{id}", func(w http.ResponseWriter, req *http.Request) {
+		stage, id := req.PathValue("stage"), req.PathValue("id")
+		if !h.authorizedBarrier(req, "barrier-query", stage, id) {
+			http.Error(w, "unauthorized", http.StatusUnauthorized)
+			return
+		}
+		writeJSON(w, http.StatusOK, h.registry.BarrierStatus(stage, id))
+	})
+	mux.HandleFunc("GET /v3/wbb/lifecycle", func(w http.ResponseWriter, req *http.Request) {
+		if !h.authorized(req, "lifecycle", "", "") {
+			http.Error(w, "unauthorized", http.StatusUnauthorized)
+			return
+		}
+		writeJSON(w, http.StatusOK, h.registry.Lifecycle())
+	})
+	mux.HandleFunc("GET /v3/wbb/operations/{id}", func(w http.ResponseWriter, req *http.Request) {
+		id := req.PathValue("id")
+		epoch := req.URL.Query().Get("epoch")
+		if _, err := uuid.Parse(id); err != nil || epoch == "" {
+			http.Error(w, "invalid operation", http.StatusBadRequest)
+			return
+		}
+		if !h.authorized(req, "query", epoch, id) {
+			http.Error(w, "unauthorized", http.StatusUnauthorized)
+			return
+		}
+		writeJSON(w, http.StatusOK, h.registry.QueryEpoch(epoch, id))
+	})
+	mux.HandleFunc("POST /v3/wbb/operations/{id}/close", func(w http.ResponseWriter, req *http.Request) {
+		id := req.PathValue("id")
+		epoch := req.Header.Get("X-WBB-Epoch")
+		if _, err := uuid.Parse(id); err != nil || epoch == "" {
+			http.Error(w, "invalid operation", http.StatusBadRequest)
+			return
+		}
+		if !h.authorized(req, "close", epoch, id) {
+			http.Error(w, "unauthorized", http.StatusUnauthorized)
+			return
+		}
+		if epoch != h.registry.epoch {
+			writeJSON(w, http.StatusOK, h.registry.QueryEpoch(epoch, id))
+			return
+		}
+		s := h.registry.CloseOperation(id)
+		if s.State == CapacityUnknown {
+			writeJSON(w, http.StatusServiceUnavailable, s)
+			return
+		}
+		writeJSON(w, http.StatusAccepted, s)
+	})
+	return mux
+}
+
+func writeJSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	json.NewEncoder(w).Encode(v) //nolint:errcheck
+}
+
+func (h *HTTP) Start(address string) error {
+	if address == "" || strings.HasPrefix(address, ":") {
+		return errors.New("management address must be explicit")
+	}
+	ln, err := net.Listen("tcp", address)
+	if err != nil {
+		return err
+	}
+	h.listener = ln
+	h.server = &http.Server{Handler: h.Handler(), ReadHeaderTimeout: 3 * time.Second, ReadTimeout: 5 * time.Second, WriteTimeout: 5 * time.Second}
+	go h.server.Serve(ln) //nolint:errcheck
+	return nil
+}
+
+func (h *HTTP) Stop() {
+	if h.server == nil {
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	h.server.Shutdown(ctx) //nolint:errcheck
+}
