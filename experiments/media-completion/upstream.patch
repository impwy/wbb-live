+func TestBarrierAbortRejectsNewAndReleasesHeld(t *testing.T) {
+	r := newMemoryRegistry("slot-a", "epoch-a", 2)
+	r.EnableBarriers()
+	if err := r.ArmBarrier(DuringAuth, "a"); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() { done <- r.WaitBarrier(DuringAuth, "a") }()
+	deadline := time.Now().Add(time.Second)
+	for !r.BarrierStatus(DuringAuth, "a").Arrived && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if !r.BarrierStatus(DuringAuth, "a").Arrived {
+		t.Fatal("barrier not entered")
+	}
+	r.AbortBarriers()
+	r.AbortBarriers()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("aborted barrier succeeded")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("held work not released")
+	}
+	if err := r.WaitBarrier(DuringAuth, "a"); err == nil {
+		t.Fatal("new waiter accepted after abort")
+	}
+	if err := r.ArmBarrier(DuringAuth, "b"); err == nil {
+		t.Fatal("new arm accepted after abort")
+	}
+}
