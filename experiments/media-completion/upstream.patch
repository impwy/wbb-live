+func TestBarrierRequiresExplicitReleaseAfterClose(t *testing.T) {
+	r := newMemoryRegistry("slot-a", "epoch-a", 2)
+	r.EnableBarriers()
+	if err := r.ArmBarrier(BeforeAddPublisher, "a"); err != nil {
+		t.Fatal(err)
+	}
+	op, err := r.Begin("a", "path", "digest")
+	if err != nil {
+		t.Fatal(err)
+	}
+	op.AttachSession(func() {})
+	arrived := make(chan error, 1)
+	go func() { arrived <- r.WaitBarrier(BeforeAddPublisher, "a") }()
+	deadline := time.Now().Add(time.Second)
+	for !r.BarrierStatus(BeforeAddPublisher, "a").Arrived && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if !r.BarrierStatus(BeforeAddPublisher, "a").Arrived {
+		t.Fatal("barrier never arrived")
+	}
+	if got := r.CloseOperation("a"); got.State != Closing {
+		t.Fatalf("close state %s", got.State)
+	}
+	select {
+	case <-arrived:
+		t.Fatal("cancel released held work")
+	default:
+	}
+	if got := r.Query("a"); got.State != Closing {
+		t.Fatalf("premature completion %s", got.State)
+	}
+	if err := r.ReleaseBarrier(BeforeAddPublisher, "a"); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-arrived; err != nil {
+		t.Fatal(err)
+	}
+	op.DoneSession()
+	op.DoneCreation()
+	if got := r.Query("a"); got.State != Completed {
+		t.Fatalf("completion %s", got.State)
+	}
+}
