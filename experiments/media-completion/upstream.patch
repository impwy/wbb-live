+	udpReservation, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	require.NoError(t, err)
+	udpAddress := udpReservation.LocalAddr().String()
+	require.NoError(t, udpReservation.Close())
+	httpReservation, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	httpAddress := httpReservation.Addr().String()
+	require.NoError(t, httpReservation.Close())
+
+	s := &Server{
+		Address:         httpAddress,
+		LocalUDPAddress: udpAddress,
+		LocalTCPAddress: tcp.Addr().String(),
+		Parent:          test.NilLogger,
+	}
+	require.Error(t, s.Initialize())
+	conn, err := net.DialTimeout("tcp", httpAddress, 100*time.Millisecond)
+	if err == nil {
+		conn.Close()
+	}
+	require.Error(t, err, "WHIP accepted requests despite failed ICE TCP initialization")
+
+	udp, err := net.ListenPacket("udp4", udpAddress)
+	require.NoError(t, err, "failed ICE initialization retained its UDP listener")
+	require.NoError(t, udp.Close())
+}
