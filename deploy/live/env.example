# Copy to .env (chmod 600). Never commit real values.
WBB_PUBLIC_ORIGIN=https://live.wombatburrow.com
# Standalone server without a host Caddy: 1 adds the TLS front on 80/443.
WBB_PUBLIC_HOST=live.wombatburrow.com
WBB_STANDALONE=0
WBB_DB_PASSWORD=<random-url-safe-password>
WBB_JWT_SECRET=<random-at-least-32-bytes>
WBB_MEDIA_SECRET=<separate-64-character-ASCII-token>
WBB_COMPLETION_KEY_HEX=<separate-32-byte-key-in-hex>
WBB_COMPLETION_ROOT=<immutable-bootstrap-root>
WBB_COMPLETION_SLOT=<immutable-bootstrap-slot>
# ICE candidates advertised to browsers: public IP and LAN IP, comma separated.
WBB_ICE_HOSTS=<public-ip>,<lan-ip>
WBB_ICE_PORT=18391
WBB_EDGE_PORT=19480
WBB_WEB_DIR=./web
# Evaluation login (all three or none). The account is created first via signup.
WBB_EVAL_LOGIN_ENABLED=false
WBB_EVAL_LOGIN_EMAIL=
WBB_EVAL_LOGIN_PASSWORD=
